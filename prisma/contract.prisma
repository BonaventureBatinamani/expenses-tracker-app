// use prisma
generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  expenses Expense[]
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal
  description String?
  date        DateTime
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}